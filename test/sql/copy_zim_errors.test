# name: test/sql/copy_zim_errors.test
# description: COPY ... TO ... (FORMAT zim) -- refusals and cleanup
# group: [sql]

require zim

statement ok
PRAGMA enable_verification

# --- the input must carry the required columns ------------------------------
# Uses only known column names (content, title) so this isolates "path is
# missing" from "an unrecognized column was rejected" -- the latter is a
# separate assertion below (an unknown column like the old 'notpath' here now
# also errors, but with "unknown column", since Task 6 added a strict
# known-column check that runs before the required-column check).
statement error
COPY (SELECT 'x' AS title, 'y' AS content) TO '__TEST_DIR__/e1.zim' (FORMAT zim);
----
must have a 'path' column

statement error
COPY (SELECT 'x' AS path) TO '__TEST_DIR__/e2.zim' (FORMAT zim);
----
must have a 'content' column

# --- refusing to overwrite --------------------------------------------------
statement ok
COPY (SELECT 'A/One' AS path, 'first' AS content)
TO '__TEST_DIR__/nooverwrite.zim' (FORMAT zim);

statement error
COPY (SELECT 'A/Two' AS path, 'second' AS content)
TO '__TEST_DIR__/nooverwrite.zim' (FORMAT zim);
----
already exists

# the original survives untouched -- the refusal must not have damaged it
query II
SELECT path, content
FROM read_zim('__TEST_DIR__/nooverwrite.zim',
              include_content := true, content_as_varchar := true);
----
A/One	first

# --- a mid-stream error leaves NO output ------------------------------------
# The CAST fails partway through, after the sink has already taken chunks. The
# global state's destructor must unlink the partial archive.
statement error
COPY (SELECT 'A/' || i AS path,
             (CASE WHEN i < 5000 THEN '1' ELSE 'not-a-number' END)::INTEGER::VARCHAR AS content
      FROM range(10000) t(i))
TO '__TEST_DIR__/aborted.zim' (FORMAT zim);
----
Conversion Error

# If the file still existed this would succeed and return rows; it must fail to open.
statement error
SELECT count(*) FROM read_zim('__TEST_DIR__/aborted.zim');
----
failed to open ZIM

# and no file exists at all under that name -- not "exists but fails zim_check",
# genuinely absent. glob() on a non-matching path returns zero rows rather than
# raising, so this asserts absence directly instead of going through zim_check,
# which conflates "file is absent" with "file is present but corrupt".
query I
SELECT count(*) FROM glob('__TEST_DIR__/aborted.zim');
----
0

# --- duplicate paths --------------------------------------------------------
statement error
COPY (SELECT * FROM (VALUES ('A/Dup', 'first'), ('A/Dup', 'second')) t(path, content))
TO '__TEST_DIR__/dup.zim' (FORMAT zim);
----
duplicate path 'A/Dup'

# and it left nothing behind. zim_check() is not usable here: on this branch it
# raises InvalidInputException for an unopenable archive rather than returning
# false (see the identical reasoning above the "aborted" glob() check), so a
# missing file cannot be distinguished from a present-but-corrupt one through
# it. Assert absence directly instead.
query I
SELECT count(*) FROM glob('__TEST_DIR__/dup.zim');
----
0

# ON_CONFLICT 'first' keeps the first occurrence
statement ok
COPY (SELECT * FROM (VALUES ('A/Dup', 'first'), ('A/Dup', 'second')) t(path, content))
TO '__TEST_DIR__/dupfirst.zim' (FORMAT zim, ON_CONFLICT 'first');

query II
SELECT path, content
FROM read_zim('__TEST_DIR__/dupfirst.zim',
              include_content := true, content_as_varchar := true);
----
A/Dup	first

# 'last' cannot be done streaming and is rejected at bind time, not silently buffered
statement error
COPY (SELECT 'A/x' AS path, 'y' AS content)
TO '__TEST_DIR__/duplast.zim' (FORMAT zim, ON_CONFLICT 'last');
----
ON_CONFLICT 'last' would require buffering every row

statement error
COPY (SELECT 'A/x' AS path, 'y' AS content)
TO '__TEST_DIR__/dupbad.zim' (FORMAT zim, ON_CONFLICT 'sideways');
----
ON_CONFLICT must be 'error' or 'first'

# --- MAIN_PATH must name an entry the query actually produced ---------------
statement error
COPY (SELECT 'A/Home' AS path, 'hi' AS content)
TO '__TEST_DIR__/badmain.zim' (FORMAT zim, MAIN_PATH 'A/Missing');
----
MAIN_PATH 'A/Missing' does not match any entry

query I
SELECT count(*) FROM glob('__TEST_DIR__/badmain.zim');
----
0

# --- a redirect must target a path the query actually produced -------------
# libzim silently removes dangling redirects at finishZimCreation() with no
# throw and no warning (design §7.4) -- announcing each removal only through
# the stdout prints task 8 suppresses. So this must be caught before libzim
# ever sees it, the same way MAIN_PATH is validated above.
statement error
COPY (SELECT * FROM (VALUES
        ('A/Home', 'hi', false, NULL),
        ('A/Gone', NULL, true, 'A/DoesNotExist'))
      t(path, content, is_redirect, redirect_path))
TO '__TEST_DIR__/badredirect.zim' (FORMAT zim);
----
redirect 'A/Gone' -> 'A/DoesNotExist' does not match any entry in the input

# and it left nothing behind -- zim_check() is not usable here (see the
# identical reasoning above the other glob() checks in this file).
query I
SELECT count(*) FROM glob('__TEST_DIR__/badredirect.zim');
----
0

# a redirect declared before its target in the same COPY is fine -- finalize
# runs only after every row has been seen, so declaration order cannot matter.
statement ok
COPY (SELECT * FROM (VALUES
        ('A/Alias', NULL, true, 'A/Real'),
        ('A/Real', 'hi', false, NULL))
      t(path, content, is_redirect, redirect_path))
TO '__TEST_DIR__/redirectorder.zim' (FORMAT zim);

query II
SELECT is_redirect, redirect_path
FROM read_zim('__TEST_DIR__/redirectorder.zim')
WHERE is_redirect;
----
true	A/Real

# a metadata key given twice, once named and once in the map, is an error
statement error
COPY (SELECT 'A/Home' AS path, 'hi' AS content)
TO '__TEST_DIR__/dupmeta.zim'
   (FORMAT zim, TITLE 'One', METADATA MAP {'Title': 'Two'});
----
metadata key 'Title' given twice

# METADATA values must be VARCHAR -- a BLOB entry would otherwise be silently
# \x-escaped by ToString(), corrupting binary content the same way ILLUSTRATION did.
statement error
COPY (SELECT 'A/Home' AS path, 'hi' AS content)
TO '__TEST_DIR__/badmetablob.zim' (FORMAT zim, METADATA MAP {'Title': '\x89PNG'::BLOB});
----
METADATA values must be VARCHAR

query I
SELECT count(*) FROM glob('__TEST_DIR__/badmetablob.zim');
----
0

# --- INDEX needs a language -------------------------------------------------
statement error
COPY (SELECT 'A/x' AS path, 'y' AS content)
TO '__TEST_DIR__/noidxlang.zim' (FORMAT zim, INDEX true);
----
INDEX requires a language

statement error
COPY (SELECT 'A/x' AS path, 'y' AS content)
TO '__TEST_DIR__/badcomp.zim' (FORMAT zim, COMPRESSION 'gzip');
----
COMPRESSION must be

# --- a genuinely unknown column is still an error ---------------------------
statement error
COPY (SELECT 'A/x' AS path, 'y' AS content, 'z' AS titel)
TO '__TEST_DIR__/typo.zim' (FORMAT zim);
----
unknown column 'titel'

# --- v2 columns are refused as deferred, not as typos -----------------------
# entry_kind is a v2 column. In v1 it cannot be accepted at all, so the error
# says "not supported yet" rather than "unknown column" -- a deferral must read
# as a deferral. There is deliberately no mutual-exclusion check against
# is_redirect here: a column that cannot be supplied at all cannot conflict
# with anything, so such a check would be unreachable in v1.
statement error
COPY (SELECT 'A/x' AS path, 'y' AS content, false AS is_redirect, 'item' AS entry_kind)
TO '__TEST_DIR__/bothspellings.zim' (FORMAT zim);
----
not supported yet

# --- options that must be refused, not ignored ------------------------------
# PARTITION_BY is consumed by DuckDB's own binder before copy_to_bind ever sees
# it (bind_copy.cpp clears stmt.info->options after extracting it), so the
# rejection has to happen in initialize_operator, which is the only hook that
# sees the PhysicalCopyToFile carrying partition_columns.
statement error
COPY (SELECT 'A/x' AS path, 'y' AS content, 'en' AS lang)
TO '__TEST_DIR__/parts' (FORMAT zim, PARTITION_BY (lang));
----
PARTITION_BY is not supported yet

# initialize_operator fires after copy_to_initialize_global, so the partition's
# output file already exists on disk when the throw happens -- confirm the
# global state's destructor (Task 2) still unlinks it, leaving no .zim behind
# anywhere under the partition directory. zim_check() is deliberately not used
# here (see the identical reasoning above the "aborted" and "dup" glob checks).
query I
SELECT count(*) FROM glob('__TEST_DIR__/parts/**/*.zim');
----
0

# FILE_SIZE_BYTES is also consumed by DuckDB's binder before copy_to_bind, but
# DuckDB itself rejects it for any format that leaves CopyFunction::rotate_files
# unset (nullptr) -- which this extension deliberately does. No code here
# implements the rejection; this test exists to confirm DuckDB's default
# behavior actually still fires the way this extension depends on.
statement error
COPY (SELECT 'A/x' AS path, 'y' AS content)
TO '__TEST_DIR__/rot.zim' (FORMAT zim, FILE_SIZE_BYTES 1000);
----
FILE_SIZE_BYTES
