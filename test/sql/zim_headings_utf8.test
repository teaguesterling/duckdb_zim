# name: test/sql/zim_headings_utf8.test
# description: nested heading structure survives intact, and a text entry that is not valid UTF-8 is refused as text but recoverable as BLOB
# group: [sql]

require zim

# Fixture: test/oracle/test_headings.zim, generated by
# test/oracle/make_headings_fixture.py. Kept separate from test.zim on purpose --
# test.zim is referenced by ten test files with hard entry-count assertions and
# its per-entry digests are pinned by zim_get_text_golden.test, so adding entries
# there would ripple through all of them for no gain.

# --- Both entries present, with the mimetypes the generator declared ----------
#
# A/BadUtf8 is declared text/plain, NOT a binary type. That matters: a binary
# entry is refused on mimetype before decoding is ever attempted, so it never
# exercises the decode path. This one does.

query I
SELECT path || ' [' || coalesce(mimetype, 'NULL') || ']'
FROM read_zim('test/oracle/test_headings.zim') ORDER BY path;
----
A/BadUtf8 [text/plain]
A/Nested [text/html]

# --- Nested headings: h1 / h2 / h2 / h3 --------------------------------------
#
# test.zim's articles carry a single <h1>, so a table-of-contents assertion
# against them has exactly one entry and would pass an implementation with
# broken level arithmetic or sibling ordering. This article has a real tree.

query I
SELECT zim_get_text('test/oracle/test_headings.zim', 'A/Nested');
----
<html><body><h1>Roots</h1><p>Top.</p><h2>Alpha</h2><p>First branch.</p><h2>Beta</h2><p>Second branch.</p><h3>Beta One</h3><p>Leaf under Beta.</p></body></html>

query I
SELECT length(zim_get_text('test/oracle/test_headings.zim', 'A/Nested'));
----
159

query I
SELECT md5(zim_get_text('test/oracle/test_headings.zim', 'A/Nested'));
----
59037b4349bc5d1bd593f3473d1c668c

# Both h2 siblings and the h3 survive, in source order. Asserted separately from
# the byte-exact text above so a failure says WHICH part of the tree was lost.

# No lambda: DuckDB v2.0 rejects the `x -> x` arrow syntax (Binder Error on
# v2.0-cyanoptera; v1.5.5 already warns), and the list_transform this used to
# wrap was an identity.
query I
SELECT regexp_extract_all(zim_get_text('test/oracle/test_headings.zim', 'A/Nested'),
                          '<h([1-3])>([^<]*)</h[1-3]>');
----
[<h1>Roots</h1>, <h2>Alpha</h2>, <h2>Beta</h2>, <h3>Beta One</h3>]

# --- A text entry whose bytes are not valid UTF-8 ----------------------------
#
# The VARCHAR-vs-BLOB boundary. The content is Latin-1 `caf<E9> na<EF>ve`; 0xE9
# and 0xEF are invalid standalone bytes in UTF-8.
#
# The contract being pinned is two-sided, and BOTH halves matter:
#   - as text, it is refused (NULL) rather than mangled or lossily decoded
#   - as BLOB, the original bytes are recoverable in full
#
# A change that started substituting replacement characters would satisfy
# neither, and would be invisible to a test that only checked one side.

query I
SELECT zim_get_text('test/oracle/test_headings.zim', 'A/BadUtf8') IS NULL;
----
true

query I
SELECT zim_get_content('test/oracle/test_headings.zim', 'A/BadUtf8') IS NOT NULL;
----
true

query I
SELECT typeof(zim_get_content('test/oracle/test_headings.zim', 'A/BadUtf8'));
----
BLOB

query I
SELECT octet_length(zim_get_content('test/oracle/test_headings.zim', 'A/BadUtf8'));
----
10

query I
SELECT hex(zim_get_content('test/oracle/test_headings.zim', 'A/BadUtf8'));
----
636166E9206E61EF7665

# test_zh.zim covers non-ASCII that IS valid UTF-8 and decodes normally, so the
# two fixtures together cover both sides of the decode boundary rather than
# leaving the failing side to be discovered in production.

query I
SELECT zim_get_text('test/oracle/test_zh.zim', 'A/矩阵') IS NOT NULL;
----
true
