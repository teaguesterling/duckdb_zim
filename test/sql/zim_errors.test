# name: test/sql/zim_errors.test
# description: error handling and binder validation
# group: [sql]

#
# statement error matches a SUBSTRING of the error message; the substrings below
# are chosen to be stable parts of the messages emitted in src/.

require zim

# unknown named parameter is rejected at bind time (DuckDB's binder rejects it
# before read_zim's own bind runs, hence "Invalid named parameter").
statement error
SELECT * FROM read_zim('test/oracle/test.zim', bogus := true);
----
Invalid named parameter

# listing must be 'path' or 'title'
statement error
SELECT * FROM read_zim('test/oracle/test.zim', listing := 'sideways');
----
listing must be 'path' or 'title'

# opening a non-existent archive fails (surfaced from ArchivePool::Get)
statement error
SELECT * FROM read_zim('/no/such/archive.zim');
----
failed to open ZIM

# unknown parameter on the metadata function too
statement error
SELECT * FROM read_zim_metadata('test/oracle/test.zim', bogus := true);
----
Invalid named parameter

# scalar over a bad archive path also errors
statement error
SELECT zim_info('/no/such/archive.zim');
----
failed to open ZIM

# --- conflicting parameter modes are rejected, not silently last-wins -------------

# two exact keys
statement error
SELECT * FROM read_zim('test/oracle/test.zim', path := 'A/Calcium', title := 'Calcium');
----
specify only one of path or title

# two prefixes
statement error
SELECT * FROM read_zim('test/oracle/test.zim', path_prefix := 'A/', title_prefix := 'C');
----
specify only one of path_prefix or title_prefix

# exact lookup mixed with a listing/prefix
statement error
SELECT * FROM read_zim('test/oracle/test.zim', path := 'A/Calcium', path_prefix := 'A/');
----
exact lookup (path/title) cannot be combined

# listing that contradicts the prefix's order
statement error
SELECT * FROM read_zim('test/oracle/test.zim', path_prefix := 'A/', listing := 'title');
----
listing := 'title' conflicts with path_prefix

# consistent prefix + listing is allowed (title_prefix is itself the title listing)
query I
SELECT count(*) >= 0 FROM read_zim('test/oracle/test.zim', title_prefix := 'C', listing := 'title');
----
true
