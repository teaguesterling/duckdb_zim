+////////////////////////////////////////////////////////////////////////////////
+// StreamFileReader
+////////////////////////////////////////////////////////////////////////////////
+
+StreamFileReader::StreamFileReader(std::shared_ptr<const IRandomAccessReader> source, offset_t offset, zsize_t size)
+  : BaseFileReader(offset, size)
+    , m_source(source)
+{
+}
+
+char StreamFileReader::readImpl(offset_t offset) const
+{
+  offset += _offset;
+  char ret;
+  try {
+    m_source->readAt(&ret, offset.v, 1);
+  } catch (std::runtime_error& e) {
+    Formatter fmt;
+    fmt << "Cannot read a char.\n";
+    fmt << " - Reading offset at " << offset.v << "\n";
+    fmt << " - error is " << e.what() << "\n";
+    throwSystemError(fmt);
+  };
+  return ret;
+}
+
+void StreamFileReader::readImpl(char* dest, offset_t offset, zsize_t size) const
+{
+  offset += _offset;
+  try {
+    m_source->readAt(dest, offset.v, size.v);
+  } catch (std::runtime_error& e) {
+    Formatter fmt;
+    fmt << "Cannot read chars.\n";
+    fmt << " - Reading offset at " << offset.v << "\n";
+    fmt << " - size is " << size.v << "\n";
+    fmt << " - error is " << e.what() << "\n";
+    throwSystemError(fmt);
+  };
+}
+
+const Buffer StreamFileReader::get_mmap_buffer(offset_t offset, zsize_t size) const {
+#ifdef ENABLE_USE_MMAP
+  // A user-provided reader has no file descriptor to mmap. Fall back to the
+  // allocate-and-read path in BaseFileReader::get_buffer.
+  throw MMapException();
+#else
+  return Buffer::makeBuffer(size); // unreachable; get_buffer never calls this when mmap is off
+#endif
+}
+
+std::unique_ptr<const Reader>
+StreamFileReader::sub_reader(offset_t offset, zsize_t size) const
+{
+  ASSERT(offset.v+size.v, <=, _size.v);
+  return std::unique_ptr<const Reader>(new StreamFileReader(m_source, _offset + offset, size));
+}
+
 } // zim
