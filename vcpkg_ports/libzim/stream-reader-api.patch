+#ifndef ZIM_IRANDOMACCESSREADER_H
+#define ZIM_IRANDOMACCESSREADER_H
+
+#include "zim.h"
+
+namespace zim
+{
+
+/**
+ * A user-providable source of positioned (random-access) reads over a single
+ * ZIM archive.
+ *
+ * Implement this interface to let libzim read a ZIM file from arbitrary storage
+ * that is not a local file descriptor -- for example a remote object fetched
+ * over HTTP/S3 with byte-range requests. Pass an instance to the
+ * Archive(std::shared_ptr<IRandomAccessReader>, OpenConfig) constructor.
+ *
+ * The whole archive is presented as a single contiguous byte range
+ * [0, getSize()). libzim issues positioned reads against it on demand, so only
+ * the bytes that a given operation touches need to be fetched.
+ *
+ * Threading: libzim may call readAt() concurrently from multiple threads.
+ * Implementations must make readAt() safe for concurrent use.
+ *
+ * Limitation: full-text (Xapian) search is not available through this path. The
+ * Xapian index is opened by libzim via a direct file descriptor into the ZIM,
+ * which a custom reader cannot provide; search operations simply return no
+ * results. All other access (enumeration, lookup, content, metadata, prefix
+ * suggestions) works normally.
+ */
+class LIBZIM_API IRandomAccessReader
+{
+  public:
+    virtual ~IRandomAccessReader();
+
+    /** The total size, in bytes, of the archive exposed by this reader. */
+    virtual size_type getSize() const = 0;
+
+    /**
+     * Read exactly `size` bytes starting at byte `offset` into `dest`.
+     *
+     * `dest` must point to a buffer of at least `size` bytes. The range
+     * [offset, offset+size) is always within [0, getSize()). Implementations
+     * must throw (e.g. std::runtime_error) if the requested bytes cannot be
+     * fully retrieved; a short read is an error, not a partial success.
+     *
+     * Must be safe to call concurrently from multiple threads.
+     */
+    virtual void readAt(char* dest, offset_type offset, size_type size) const = 0;
+};
+
+} // namespace zim
+
+#endif // ZIM_IRANDOMACCESSREADER_H
