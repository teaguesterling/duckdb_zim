+// Adapter that turns a user-provided IRandomAccessReader (positioned reads over
+// an opaque byte source, e.g. a remote HTTP/S3 object) into a libzim Reader.
+// Modeled on FileReader, but reads through IRandomAccessReader::readAt instead
+// of a file descriptor and never mmaps (get_mmap_buffer always defers to the
+// allocate-and-read fallback in BaseFileReader::get_buffer).
+class LIBZIM_PRIVATE_API StreamFileReader : public BaseFileReader {
+  public: // functions
+    StreamFileReader(std::shared_ptr<const IRandomAccessReader> source,
+                     offset_t offset, zsize_t size);
+    ~StreamFileReader() = default;
+
+    const Buffer get_mmap_buffer(offset_t offset, zsize_t size) const override;
+    std::unique_ptr<const Reader> sub_reader(offset_t offset, zsize_t size) const override;
+
+  private: // functions
+    char readImpl(offset_t offset) const override;
+    void readImpl(char *dest, offset_t offset, zsize_t size) const override;
+
+  private: // data
+    std::shared_ptr<const IRandomAccessReader> m_source;
+};
