+namespace {
+  // Adapts libzim's whole-archive Reader into a Xapian::RandomAccessReader over
+  // the uncompressed fulltext-index byte range [base, base+size). Lets Xapian
+  // fetch only the glass blocks a query touches, via the archive's byte-range reader.
+  class ZimXapianReader : public Xapian::RandomAccessReader {
+    std::shared_ptr<const Reader> m_reader;
+    offset_type m_base;
+    std::size_t m_size;
+   public:
+    ZimXapianReader(std::shared_ptr<const Reader> reader, offset_type base, std::size_t size)
+      : m_reader(std::move(reader)), m_base(base), m_size(size) {}
+    std::size_t read_at(char* buf, off_t pos, std::size_t len) const override {
+      if (pos < 0 || std::size_t(pos) >= m_size) {
+        return 0;
+      }
+      std::size_t avail = std::min(len, m_size - std::size_t(pos));
+      m_reader->read(buf, offset_t(m_base + offset_type(pos)), zsize_t(avail));
+      return avail;
+    }
+    off_t get_size() const override { return off_t(m_size); }
+  };
+}
+
+  bool FileImpl::getReaderBackedXapianDb(entry_index_t direntIdx, Xapian::Database& db,
+                                         std::shared_ptr<Xapian::RandomAccessReader>& hold) const {
+    if (zimFile) {
+      return false; // only reader-backed (remote) archives need this path
+    }
+    auto dirent = getDirent(direntIdx);
+    if (dirent->isRedirect()) {
+      return false;
+    }
+    auto cluster = getCluster(dirent->getClusterNumber());
+    if (cluster->isCompressed()) {
+      return false;
+    }
+    zsize_t idxSize = cluster->getBlobSize(dirent->getBlobNumber());
+    if (idxSize.v == 0) {
+      return false;
+    }
+#ifndef _WIN32
+    if (m_maxLocalSearchIndexBytes > 0 && idxSize.v <= m_maxLocalSearchIndexBytes) {
+      auto blob = getBlob(*dirent);
+      char tmpl[] = "/tmp/libzim-xapian-XXXXXX";
+      int tmpfd = mkstemp(tmpl);
+      if (tmpfd < 0) {
+        return false;
+      }
+      ::unlink(tmpl);
+      const char* data = blob.data();
+      size_t remaining = blob.size();
+      while (remaining > 0) {
+        ssize_t w = ::write(tmpfd, data, remaining);
+        if (w <= 0) { ::close(tmpfd); return false; }
+        data += w; remaining -= size_t(w);
+      }
+      if (::lseek(tmpfd, 0, SEEK_SET) != 0) { ::close(tmpfd); return false; }
+      try {
+        db = Xapian::Database(tmpfd);
+      } catch (Xapian::DatabaseError&) {
+        ::close(tmpfd);
+        return false;
+      }
+      return true;
+    }
+#endif
+    offset_type idxOffset =
+      getBlobOffset(dirent->getClusterNumber(), dirent->getBlobNumber()).v;
+    hold = std::make_shared<ZimXapianReader>(zimReader, idxOffset, std::size_t(idxSize.v));
+    try {
+      db = Xapian::Database(*hold);
+    } catch (Xapian::DatabaseError&) {
+      return false;
+    }
+    return true;
+  }
