+#ifndef XAPIAN_INCLUDED_RANDOMACCESSREADER_H
+#define XAPIAN_INCLUDED_RANDOMACCESSREADER_H
+
+#if !defined XAPIAN_IN_XAPIAN_H && !defined XAPIAN_LIB_BUILD
+# error Never use <xapian/randomaccessreader.h> directly; include <xapian.h> instead.
+#endif
+
+#include <xapian/visibility.h>
+
+#include <cstddef>
+#include <sys/types.h>
+
+namespace Xapian {
+
+/** Abstract source of random-access bytes for a single-file database.
+ *
+ *  Pass an implementation to Database(RandomAccessReader&) to open a glass
+ *  database image that is not a local file (e.g. a byte range served over
+ *  HTTP, or an index embedded inside a larger container). The glass backend
+ *  issues positioned reads against it on demand, so only the blocks a query
+ *  touches are fetched.
+ *
+ *  Threading: read_at() may be called concurrently from multiple threads;
+ *  implementations must make it safe for concurrent use.
+ */
+class XAPIAN_VISIBILITY_DEFAULT RandomAccessReader {
+  public:
+    virtual ~RandomAccessReader();
+
+    /** Read bytes at a byte offset.
+     *
+     *  @param buf   Destination buffer (at least @a len bytes).
+     *  @param pos   Byte offset to read from, in [0, get_size()).
+     *  @param len   Number of bytes to read.
+     *  @return      Number of bytes actually read; may be less than @a len
+     *               only when @a pos + @a len would exceed get_size().
+     */
+    virtual std::size_t read_at(char* buf, off_t pos, std::size_t len) const = 0;
+
+    /** The total number of addressable bytes (the database image size). */
+    virtual off_t get_size() const = 0;
+};
+
+}
